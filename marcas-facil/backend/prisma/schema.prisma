// MARCA FÁCIL — Schema de base de datos PostgreSQL + Prisma
// Honorio M. Leguizamón Pondal — Agente PI Mat. N° 1974

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DIRECT_URL necesaria para migraciones con Supabase Transaction Pooler
  directUrl = env("DIRECT_URL")
}

// ============================================================
// USUARIOS Y AUTENTICACIÓN
// ============================================================

model User {
  id              String   @id @default(uuid())
  cuit            String   @unique          // CUIT sin guiones, 11 dígitos
  email           String   @unique
  passwordHash    String
  razonSocial     String                    // Nombre o razón social del titular
  tipoPersona     TipoPersona @default(FISICA)
  domicilio       String?
  telefono        String?

  // Red de referidos
  referralCode    String?  @unique          // Código propio del usuario
  referredByCode  String?                   // Código del agente/reseller que lo refirió
  agenteCuit      String?                   // CUIT del agente asignado (default: Honorio)

  // Suscripción
  plan            Plan     @default(GRATUITO)
  planVencimiento DateTime?
  mpCustomerId    String?                   // ID de cliente en MercadoPago

  // Estado y control
  activo          Boolean  @default(true)
  emailVerified   Boolean  @default(false)
  terminosAceptados Boolean @default(false)
  terminosVersion String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastLoginAt     DateTime?

  // Relaciones
  pushTokens      PushToken[]
  marcas          Marca[]
  dominios        Dominio[]
  alertas         Alerta[]
  pagos           Pago[]
  estudiosFactibilidad EstudioFactibilidad[]

  @@index([cuit])
  @@index([email])
  @@index([referredByCode])
  @@map("users")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   // "ios" | "android" | "web"
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("push_tokens")
}

// ============================================================
// TITULARES
// ============================================================

// Una marca puede tener varios titulares, cada uno con su porcentaje. El
// modelo anterior guardaba uno solo —`titularNombre` y `titularCuit` en la
// propia marca— y eso perdía a los cotitulares en silencio.
//
// No es un detalle de prolijidad: la legitimación para oponerse es del
// titular. Una marca al 50/50 donde el sistema conoce a uno solo genera un
// escrito que omite a un legitimado.
//
// `Marca.titularNombre` y `Marca.titularCuit` se conservan y siguen siendo el
// titular principal —el de mayor porcentaje— porque la app los usa en
// listados y búsquedas donde traer la relación entera sería gratuito ruido.
// La verdad completa está acá.
model TitularMarca {
  id              String   @id @default(uuid())
  marcaId         String

  nombre          String
  // Del INPI viene como "100.00", "50.00". Se guarda tal cual: es un dato de
  // la ficha, no una cuenta nuestra.
  porcentaje      String?

  cuit            String?
  tipoDocumento   String?   // "1-Documento Nacional de Identidad"
  documento       String?
  genero          String?
  pais            String?

  domicilioReal   String?
  localidad       String?
  codigoPostal    String?

  // De dónde salió: "INPI" (ficha del portal) o "MANUAL".
  origen          String   @default("INPI")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  marca           Marca    @relation(fields: [marcaId], references: [id], onDelete: Cascade)

  @@index([marcaId])
  @@index([cuit])
  @@map("titulares_marca")
}

// ============================================================
// CLASIFICACIÓN DE VIENA
// ============================================================

// El INPI no aplica la Clasificación de Viena de oficio: el (531) no aparece
// en el Boletín, el Web Service no devuelve nada figurativo y el arancel sólo
// ofrece búsqueda fonética y por titular. La aplicamos nosotros.
//
// Eso obliga a tres cosas que no son opcionales, porque un código propio que
// no se puede auditar no sirve para fundar una oposición:
//
//   1. VERSIONAR. Cada código guarda con qué clasificador y en qué fecha se
//      asignó. Cambiar el clasificador no puede reescribir en silencio lo que
//      ya se vigiló: una oposición se funda en lo que el sistema vio ESE DÍA.
//   2. LA CORRECCIÓN MANUAL GANA SIEMPRE. `MANUAL` sobrevive a toda
//      reclasificación posterior, sin excepción.
//   3. GUARDAR LA IMAGEN clasificada — vive en `Marca` y `BoletinEntrada`.
//
// Se usa en los dos extremos del cotejo figurativo —el dibujo del cliente al
// solicitar, y el del tercero al leer el Boletín— y tiene que ser la MISMA
// función. Si cada lado se clasifica con un criterio distinto, la vigilancia
// figurativa no encuentra nada y el defecto es invisible: no produce un error,
// produce silencio.
model CodigoViena {
  id              String   @id @default(uuid())

  // Uno de los dos, nunca los dos: el dibujo es de una marca de la cartera o
  // de una solicitud publicada en el Boletín.
  marcaId          String?
  boletinEntradaId String?

  // "07.01.24" — categoría.división.sección
  codigo          String
  // Desglosado, porque la coincidencia es graduada y se consulta por nivel:
  // los tres iguales = el mismo elemento; categoría y división = mismo grupo;
  // sólo categoría = familia lejana. Mismo diseño que la afinidad de clases.
  categoria       Int
  division        Int
  seccion         Int

  // Qué se vio, en palabras. Sirve para revisar una clasificación sin abrir la
  // imagen y para comparar contra el elemento figurativo heredado de Damlong.
  descripcion     String?

  origen          OrigenClasificacion @default(AUTOMATICO)
  // Qué clasificador lo asignó. Cambiar de clasificador no reescribe lo viejo:
  // se agregan códigos nuevos y los anteriores quedan con su versión.
  clasificadorVersion String
  // Edición de la Clasificación de Viena. La 10.ª rige desde el 1/1/2026, y un
  // código de la 9.ª no significa lo mismo: las ediciones cambian secciones.
  edicion         String   @default("VCL10")
  // 0 a 1. NULL cuando lo puso una persona: ahí no hay confianza que estimar.
  confianza       Float?

  asignadoEn      DateTime @default(now())

  marca           Marca?          @relation(fields: [marcaId], references: [id], onDelete: Cascade)
  boletinEntrada  BoletinEntrada? @relation(fields: [boletinEntradaId], references: [id], onDelete: Cascade)

  @@index([marcaId])
  @@index([boletinEntradaId])
  @@index([codigo])
  @@index([categoria, division, seccion])
  @@map("codigos_viena")
}

enum OrigenClasificacion {
  AUTOMATICO
  MANUAL
}

// ============================================================
// MARCAS
// ============================================================

enum TipoNotoriedad {
  NOTORIA
  RENOMBRADA
}

model Marca {
  id              String       @id @default(uuid())
  userId          String

  // Datos del registro INPI
  acta            String?      // Número de acta (ej: "4500123")
  resolucion      String?      // Número de resolución si fue concedida
  denominacion    String
  tipoMarca       TipoMarca    @default(DENOMINATIVA)
  claseNiza       Int          // 1-45
  // ⚠️ NULLABLE desde la importación de cartera (26/09/2026).
  //
  //    El (57) del INPI: la descripción real de productos y servicios que
  //    ampara la marca. Damlong NO lo guarda —las columnas rubro, cobertura,
  //    cobertuin y negocio vinieron vacías en las 843 filas del export— así
  //    que las marcas importadas entran sin este dato y se completa después
  //    desde el INPI por número de acta.
  //
  //    Se evaluó rellenarlo con el encabezado de la clase de Niza y se
  //    descartó: el encabezado es el alcance máximo de la clase, no el de la
  //    marca. Una marca registrada sólo para calzado quedaría invocando
  //    "prendas de vestir, calzado y artículos de sombrerería", y en el cotejo
  //    de productos afines eso le regala al contrario un argumento.
  //
  //    Vacío significa "todavía no lo sabemos" y bloquea la generación del
  //    escrito de oposición. Un placeholder lo haría indistinguible de un
  //    dato bueno, que es justo lo que no puede pasar.
  productos       String?

  // Titular
  //
  // ⚠️ NULLABLE por la misma razón, y con una de más: el CUIT del titular no
  //    está en Damlong (1 de 315 titulares lo tenía cargado; de los 135 que
  //    corresponden a la cartera vigilada, ninguno). Se recupera del INPI.
  //
  //    Se descartó completarlo con el CUIT del estudio: `titularCuit` es el
  //    CUIT de QUIEN ES TITULAR de la marca, y la legitimación para oponerse
  //    es del titular, no del agente. Poner el del estudio haría que la app
  //    generara escritos declarando una titularidad que no existe. El CUIT
  //    del estudio va en `agenteCuit`, que es donde corresponde y es cierto.
  //
  //    `titularNombre` sí viene completo de Damlong (843 de 843), así que de
  //    quién es cada marca no se pierde: falta la clave fiscal, no el dueño.
  titularCuit     String?
  titularNombre   String

  // Estado y fechas
  estado          EstadoMarca  @default(BORRADOR)
  fechaIngreso    DateTime?    // Presentación ante INPI
  fechaPublicacion DateTime?   // Publicación en Boletín de Marcas
  fechaConcesion  DateTime?    // Fecha de concesión
  fechaVencimiento DateTime?   // 10 años desde concesión

  // DDJJ de uso (Art. 26 Ley 22.362) — año 6 desde concesión
  ddjjUsoPresentada Boolean    @default(false)
  ddjjUsoFecha      DateTime?
  ddjjVencimiento   DateTime?  // Cierre de la ventana (año 7)

  // Logo / imagen (para figurativas y mixtas)
  logoUrl         String?

  // ── El dibujo, tal como se clasificó ──────────────────────────────────────
  //
  // Se guarda la IMAGEN, no sólo el código. Sin la imagen no se puede revisar
  // una clasificación discutida ni reclasificar con un clasificador nuevo, y
  // una clasificación que no se puede auditar no sirve para fundar nada.
  //
  // Se trae del INPI con un POST a MarcasConsultas/Resultado llevando el acta
  // en el cuerpo: viene embebida en base64 dentro de la ficha. Por número de
  // acta no hay ambigüedad posible, a diferencia de extraerla del PDF del
  // Boletín y emparejarla por posición, donde un corrimiento de una sola
  // página le asigna el logo de un tercero a un acta ajena.
  logoBase64      String?     // la imagen tal cual vino, sin el prefijo data:
  logoFormato     String?     // jpg, png…
  huellaVisual    String?     // dHash de 64 bits en hexadecimal
  huellaProporcion Float?     // ancho/alto, para descartar comparaciones absurdas

  // ⚠️ Heredado del export de Damlong, que exige cargar las mixtas y
  //    figurativas con el dibujo descrito entre paréntesis: «NAHANA (CASA)».
  //
  //    NO es la clasificación y no reemplaza a Viena: sólo 38 de las 290
  //    marcas con dibujo lo traen, y ninguna marca nueva lo va a traer, porque
  //    es una convención de otro programa. Sirve como semilla para el mapeo
  //    inicial y, sobre todo, como control cruzado: si el clasificador dice
  //    «flor» donde el agente escribió «casa», hay algo para mirar.
  elementoFigurativo String?

  // ── Datos de la ficha del INPI ────────────────────────────────────────────
  resolucionTipo      String?   // Concedida, Denegada…
  resolucionMotivo    String?   // Estudio Simplificado, Sin oposición…
  disposicionNumero   String?   // DI-2026-26-APN-DNM#INPI
  disposicionFecha    DateTime?
  boletinNotificacion String?   // número de boletín donde se notificó
  ubicacionExpediente String?

  // Cuándo se trajo la ficha por última vez. NULL = nunca: el dato que falte
  // en esta marca falta porque no se consultó, no porque el INPI no lo tenga.
  fichaActualizadaEn  DateTime?

  // Agente que presentó
  agenteCuit      String?

  // Vigilancia automática contra el Boletín
  vigilanciaActiva Boolean    @default(true)

  // ── Vigilancia ampliada — módulo pago para notorias y renombradas ─────────
  //
  // `false` (default): se vigila la clase idéntica más las afines de la tabla
  // `afinidadClases.ts`. Es el alcance de todos los clientes.
  //
  // `true`: se vigila en las 45 clases, con umbral de identidad o
  // cuasi-identidad (`cuasiIdentidad.ts`). En clase no afín no hay proximidad
  // comercial que corrobore, así que el umbral normal sería ruido puro.
  vigilanciaAmpliada Boolean  @default(false)

  // Documenta el encuadre y funda el escrito; NO determina el alcance, que lo
  // fija `vigilanciaAmpliada`. Se separan porque en la práctica las dos
  // figuras se confunden y se les aplica protección mayor a las dos.
  //
  //   `NOTORIA`    — CUP 6 bis + ADPIC 16.2. La conoce el sector pertinente.
  //                  Excepciona territorialidad y registro: se protege sin
  //                  registro local.
  //   `RENOMBRADA` — ADPIC 16.3. La conoce el público en general. Excepciona
  //                  la especialidad: alcanza cualquier clase. Exige registro.
  tipoNotoriedad  TipoNotoriedad?

  notas           String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  oposicionesFormuladas Oposicion[] @relation("MarcaOponente")   // Oposiciones que ESTA marca formuló
  oposicionesRecibidas  Oposicion[] @relation("MarcaOpuesta")    // Oposiciones CONTRA esta marca
  alertas         Alerta[]
  documentos      Documento[]
  estudiosFactibilidad EstudioFactibilidad[]
  titulares       TitularMarca[]
  codigosViena    CodigoViena[]

  @@index([userId])
  @@index([claseNiza])
  @@index([denominacion])
  @@index([estado])
  @@map("marcas")
}

// ============================================================
// BOLETÍN DE MARCAS (publicado todos los MIÉRCOLES)
// ============================================================

model BoletinEntrada {
  id              String   @id @default(uuid())
  fechaBoletin    DateTime // Miércoles de publicación
  boletinNumero   String?  // Número del boletín

  // Datos de la marca publicada en el boletín
  acta            String   @unique
  claseNiza       Int

  // ⚠️ NULLABLE a propósito. El 51 % de las actas son mixtas o figurativas y
  //    traen el (54) vacío: la denominación está dentro del logo, que en el
  //    PDF es una imagen. Hay que pedírsela al Web Service por número de acta.
  //    Guardar "" o un placeholder haría indistinguible "no la sabemos" de
  //    "la marca se llama así", que es justo lo que no puede pasar.
  denominacion    String?

  // Código INID (40): D denominativa · M mixta · F figurativa · T 3D · R
  tipoInid        String?
  tipoMarca       String   @default("DENOMINATIVA")

  titularNombre   String   @default("No informado")
  titularCuit     String?
  productos       String?

  // (22) fecha y hora de presentación ante el INPI
  fechaPresentacion DateTime?

  // (74) matrícula del agente de la PI. NULL si fue por derecho propio.
  agenteNumero    Int?
  porDerechoPropio Boolean @default(false)

  // (59) colores reivindicados y (30) prioridad extranjera
  colores         String?
  prioridad       String?

  // El (57) del boletín a veces viene truncado y remite a una consulta aparte.
  productosTruncados Boolean @default(false)

  // ── El dibujo de la solicitud publicada ───────────────────────────────────
  //
  // Mismos campos que en `Marca`, y a propósito: el cotejo figurativo compara
  // el dibujo del cliente contra el del tercero, y si los dos lados no se
  // miden igual la comparación no significa nada.
  //
  // Se trae por número de acta desde la ficha del INPI, no extrayendo imágenes
  // del PDF: ahí las imágenes se ubican por página y posición, y un solo
  // corrimiento le asigna el logo de un tercero a un acta ajena. Eso no falla
  // con un error, funda una oposición contra quien no corresponde.
  logoBase64      String?
  logoFormato     String?
  huellaVisual    String?
  huellaProporcion Float?
  fichaActualizadaEn DateTime?

  // Control de procesamiento
  procesado       Boolean  @default(false) // Si ya se cruzó con marcas del sistema
  createdAt       DateTime @default(now())

  oposicionesGeneradas Oposicion[] @relation("BoletinOrigen")
  codigosViena    CodigoViena[]

  @@index([fechaBoletin])
  @@index([claseNiza])
  @@index([denominacion])
  @@index([agenteNumero])
  @@map("boletin_entradas")
}

model BoletinDescarga {
  id             String   @id @default(uuid())
  fechaBoletin   DateTime // Miércoles al que corresponde
  boletinNumero  String?
  urlDescargada  String?
  exitosa        Boolean  @default(false)
  totalActas     Int      @default(0)
  error          String?
  descargadoEn   DateTime @default(now())

  @@index([fechaBoletin])
  @@map("boletin_descargas")
}

// ============================================================
// OPOSICIONES
// Flujo Res. INPI 297/2026 (vigente para marcas desde 01/03/2026)
// ============================================================

model Oposicion {
  id              String          @id @default(uuid())
  userId          String

  // Marca que opone (propia del usuario)
  marcaOponenteId String

  // Marca opuesta (del Boletín o ingresada manualmente)
  boletinEntradaId String?
  marcaOpuestaId   String?
  actaOpuesta      String
  denominacionOpuesta String
  claseOpuesta     Int
  oponenteNombre   String?        // Nombre del titular de la marca opuesta
  oponenteCuit     String?

  // Datos de la oposición
  numeroOposicion  String?        // N° asignado por INPI al formular
  fechaPublicacion DateTime       // Publicación en boletín (para calcular plazo)
  plazoOposicion   DateTime?      // 30 días corridos desde el día siguiente a publicación
  fechaPresentacion DateTime?     // Fecha real de presentación ante INPI

  // Fundamentos
  fundamentosTexto String?        @db.Text

  // Estado del trámite
  estado           EstadoOposicion @default(PENDIENTE)

  // Mantenimiento — Art. 1 Res. 297/2026 (15 días hábiles)
  notificacionMantenimiento DateTime?
  plazoMantenimiento        DateTime?
  fechaMantenimiento        DateTime?  // Cuándo se presentó el mantenimiento

  // Traslado al solicitante — Art. 2 Res. 297/2026 (15 días hábiles)
  trasladoFecha    DateTime?
  plazoTraslado    DateTime?

  // Argumentos finales — Art. 6 Res. 297/2026 (10 días hábiles)
  argumentosFinales String?        @db.Text

  // Resolución del INPI
  resolucionFecha  DateTime?
  resolucionNumero String?
  resolucionTexto  String?        @db.Text

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  marcaOponente    Marca    @relation("MarcaOponente", fields: [marcaOponenteId], references: [id])
  marcaOpuesta     Marca?   @relation("MarcaOpuesta", fields: [marcaOpuestaId], references: [id])
  boletinEntrada   BoletinEntrada? @relation("BoletinOrigen", fields: [boletinEntradaId], references: [id])
  alertas          Alerta[]
  documentos       Documento[]

  @@index([userId])
  @@index([estado])
  @@index([actaOpuesta])
  @@map("oposiciones")
}

// ============================================================
// DOMINIOS NIC.AR
// ============================================================

model Dominio {
  id              String        @id @default(uuid())
  userId          String
  nombre          String        @unique  // ej: "mimarca.com.ar"
  estado          EstadoDominio @default(ACTIVO)
  fechaRegistro   DateTime?
  fechaVencimiento DateTime?
  registrante     String?       // Nombre del registrante
  notas           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertas         Alerta[]

  @@index([userId])
  @@map("dominios")
}

// ============================================================
// ALERTAS Y CALENDARIO DE VENCIMIENTOS
// ============================================================

model Alerta {
  id              String       @id @default(uuid())
  userId          String
  tipo            TipoAlerta
  titulo          String
  descripcion     String?

  // Referencias (todas opcionales)
  marcaId         String?
  oposicionId     String?
  dominioId       String?

  // Fechas
  fechaVencimiento DateTime?   // Cuando vence el plazo
  fechaAlerta     DateTime?    // Cuándo se debe notificar/mostrar

  // Estado
  leida           Boolean      @default(false)
  leidaEn         DateTime?
  notificadaPush  Boolean      @default(false)

  createdAt       DateTime @default(now())

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  marca           Marca?     @relation(fields: [marcaId], references: [id])
  oposicion       Oposicion? @relation(fields: [oposicionId], references: [id])
  dominio         Dominio?   @relation(fields: [dominioId], references: [id])

  @@index([userId])
  @@index([fechaVencimiento])
  @@index([leida])
  @@index([notificadaPush])
  @@map("alertas")
}

// ============================================================
// DOCUMENTOS GENERADOS
// ============================================================

model Documento {
  id          String        @id @default(uuid())
  userId      String
  tipo        TipoDocumento
  nombre      String
  descripcion String?
  url         String        // Path local o URL de storage
  mimeType    String        @default("application/pdf")

  // Referencias opcionales
  marcaId     String?
  oposicionId String?

  createdAt   DateTime @default(now())

  marca       Marca?     @relation(fields: [marcaId], references: [id])
  oposicion   Oposicion? @relation(fields: [oposicionId], references: [id])

  @@index([userId])
  @@index([marcaId])
  @@map("documentos")
}

// ============================================================
// PAGOS — MercadoPago
// ============================================================

model Pago {
  id              String      @id @default(uuid())
  userId          String
  mpPaymentId     String?     @unique   // ID de pago en MercadoPago
  mpPreferenceId  String?               // ID de preferencia creada
  tipo            TipoPago
  monto           Float
  moneda          String      @default("ARS")
  estado          EstadoPago  @default(PENDIENTE)
  estadoMP        String?     // Estado raw de MercadoPago
  concepto        String?     // Descripción legible del pago
  planContratado  String?     // Plan que se contrató con este pago

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([mpPaymentId])
  @@index([estado])
  @@map("pagos")
}

// ============================================================
// RESELLERS / AGENTES / RED DE DISTRIBUCIÓN
// ============================================================

model Reseller {
  id            String   @id @default(uuid())
  nombre        String
  email         String   @unique
  cuit          String   @unique
  matricula     String?  // Matrícula profesional (abogado, agente PI, etc.)
  tipoAgente    String   @default("referidor") // "abogado" | "agente_pi" | "estudio" | "camara" | "referidor"
  referralCode  String   @unique
  activo        Boolean  @default(true)
  comisionPct   Float    @default(10)         // Porcentaje de comisión
  notas         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("resellers")
}

// ============================================================
// ESTUDIOS DE FACTIBILIDAD (histórico)
// ============================================================

model EstudioFactibilidad {
  id                    String   @id @default(uuid())
  userId                String
  marcaId               String?  // Si se vincula a una marca existente

  // Datos del análisis
  denominacion          String
  claseNiza             Int
  tipoMarca             String   @default("DENOMINATIVA")
  productos             String?

  // Resultados
  antecedentes          String?  @db.Text  // JSON de antecedentes encontrados
  dictamen              String   // "VIABLE" | "CONDICIONADA" | "NO_VIABLE"
  riesgo                String   // "BAJO" | "MEDIO" | "ALTO"
  resumenDictamen       String?  @db.Text
  totalAntecedentes     Int      @default(0)
  antecedentesConfundibles Int   @default(0)

  // PDF generado
  pdfUrl                String?

  createdAt             DateTime @default(now())

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marca                 Marca?   @relation(fields: [marcaId], references: [id])

  @@index([userId])
  @@index([denominacion])
  @@map("estudios_factibilidad")
}

// ============================================================
// ENUMS
// ============================================================

enum TipoPersona {
  FISICA
  JURIDICA
}

enum Plan {
  GRATUITO
  BASICO
  PROFESIONAL
  EMPRESARIAL
}

enum TipoMarca {
  DENOMINATIVA
  FIGURATIVA
  MIXTA
  TRIDIMENSIONAL
  SONORA
  OLFATIVA
  SECUENCIAL
  TACTIL
  COMBINACION_COLORES
  POSICION
}

enum EstadoMarca {
  BORRADOR            // Ingresada en el sistema, no presentada aún
  EN_TRAMITE          // Presentada en INPI, en examen de forma
  PUBLICADA           // Publicada en Boletín (30 días de oposición)
  CONCEDIDA           // Registrada y concedida
  RECHAZADA           // Rechazada por el INPI
  ABANDONADA          // Abandonada por el titular
  VENCIDA             // Vencido el plazo de 10 años sin renovar
}

enum EstadoOposicion {
  PENDIENTE           // Detectada automáticamente, aún no presentada
  FORMULADA           // Presentada en el portal INPI (30 días)
  EN_TRAMITE          // En trámite general
  MANTENIDA           // Mantenimiento presentado (Art. 1 Res. 297/2026)
  FUNDADA             // INPI declaró la oposición FUNDADA
  INFUNDADA           // INPI declaró la oposición INFUNDADA
  DESISTIDA           // Retirada por el oponente
  ABANDONADA          // Caducó por no mantenerla en plazo
}

enum EstadoDominio {
  ACTIVO
  VENCIDO
  EN_DISPUTA
  CEDIDO
  SUSPENDIDO
}

enum TipoAlerta {
  OPOSICION_DETECTADA      // Marca confundible en Boletín — urgente
  OPOSICION_PLAZO          // Plazo para presentar oposición (30 días corridos)
  OPOSICION_MANTENIMIENTO  // Mantener oposición — 15 días hábiles (Art. 1 Res. 297/2026)
  OPOSICION_TRASLADO       // Traslado al solicitante — 15 días hábiles (Art. 2)
  DDJJ_VENCIMIENTO         // Vence DDJJ de uso de medio término (Art. 26 Ley 22.362)
  RENOVACION_VENCIMIENTO   // Vence el registro (10 años)
  DOMINIO_VENCIMIENTO      // Vence dominio NIC.AR
  VISTA_OFICIAL            // Vista de forma o de fondo del INPI
  MARCA_CONCEDIDA          // Marca concedida — notificación positiva
  CUSTOM                   // Alerta personalizada del usuario
  GENERAL
}

enum TipoDocumento {
  SOLICITUD_NUEVA
  OPOSICION
  MANTENIMIENTO_OPOSICION
  CONTESTACION_TRASLADO
  ARGUMENTOS_FINALES
  DDJJ_USO_MEDIO_TERMINO
  DDJJ_USO_RENOVACION
  CONTESTACION_VISTA
  LIMITACION
  RENOVACION
  ESTUDIO_FACTIBILIDAD
  TITULO_MARCA
  OTRO
}

enum TipoPago {
  SUSCRIPCION
  PAGO_UNICO
  SOLICITUD_MARCA
  OPOSICION_ARANCEL
  MANTENIMIENTO_OPOSICION
  RENOVACION_MARCA
  DDJJ_USO
  DOMINIO_REGISTRO
  DOMINIO_RENOVACION
  ESTUDIO_FACTIBILIDAD
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  DEVUELTO
}
